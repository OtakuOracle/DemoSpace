<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:CompileBindings="False"
        x:Class="DemoSpace.MemberWindow"
        Title="MemberWindow">


	<DockPanel>
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Content="Назад" Margin="5" Click="Back_Click"  Foreground="White" FontFamily="Times New Roman"></Button>
		</StackPanel>

		<ListBox Name="MembersBox">
			<ListBox.ItemTemplate>
				<DataTemplate>
							<DockPanel>
								<StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5">
									<TextBlock Text="{Binding User.FullName, StringFormat='ФИО:{0}'}" FontFamily="Times New Roman" Margin="5" />
									<TextBlock Text="{Binding Specialization.SpecializationName, StringFormat='Специализация:{0}'}" FontFamily="Times New Roman" Margin="5" />
									<TextBlock Text="{Binding FatigueLevel, StringFormat='Уровень усталости:{0}'}" FontFamily="Times New Roman" Margin="5" />
									<TextBlock Text="{Binding CurrentTaskNavigation.CurrentTaskName, StringFormat='Текущая задача:{0}'}" FontFamily="Times New Roman" Margin="5" />
									<TextBlock Text="{Binding StationModule.StationModuleName, StringFormat='Текущий модуль станции:{0}'}" FontFamily="Times New Roman" Margin="5" />
								</StackPanel>
							</DockPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</Window>
